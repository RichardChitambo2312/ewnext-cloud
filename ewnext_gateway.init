#!/bin/sh /etc/rc.common
# EWNext cloud gateway worker. Does not enable cloud or writes by itself.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/local/sbin/ewnext_gatewayd

start_service() {
	[ -x "$PROG" ] || return 1
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 5 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/ewnext_gateway
	procd_close_instance
}

reload_service() {
	stop
	start
}
